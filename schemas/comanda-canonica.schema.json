{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racha.app/schemas/comanda-canonica.schema.json",
  "title": "Comanda canônica",
  "description": "Estado completo de uma comanda, independente da fonte. Valores em centavos de BRL.",
  "type": "object",
  "required": ["comanda_external_id", "mesa_ref", "status", "itens"],
  "additionalProperties": false,
  "properties": {
    "comanda_external_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mesa_ref": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Identificador da mesa no sistema de origem ou rótulo cadastrado." },
    "status": { "enum": ["aberta", "fechamento_solicitado", "cancelada"] },
    "aberta_em": { "type": "string", "format": "date-time" },
    "itens": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "ajustes": {
      "type": "array",
      "items": { "$ref": "#/$defs/ajuste" },
      "default": []
    },
    "taxa_servico_bp": {
      "type": "integer", "minimum": 0, "maximum": 3000,
      "description": "Sobrescreve a taxa padrão do restaurante. 1000 = 10%."
    },
    "total_informado_centavos": {
      "type": "integer", "minimum": 0,
      "description": "Total segundo a origem. Usado para validar o cálculo; divergência gera alerta."
    },
    "metadados_origem": { "type": "object", "description": "Livre. Guardado para auditoria." }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["descricao", "quantidade", "preco_unitario_centavos"],
      "additionalProperties": false,
      "properties": {
        "external_item_id": { "type": "string", "maxLength": 128 },
        "descricao": { "type": "string", "minLength": 1, "maxLength": 200 },
        "quantidade": { "type": "integer", "minimum": 1, "maximum": 999 },
        "preco_unitario_centavos": { "type": "integer", "minimum": 0 },
        "desconto_centavos": { "type": "integer", "minimum": 0, "default": 0 },
        "aplica_taxa": { "type": "boolean", "default": true },
        "status": { "enum": ["ativo", "cancelado"], "default": "ativo" }
      }
    },
    "ajuste": {
      "type": "object",
      "required": ["tipo", "valor_centavos"],
      "additionalProperties": false,
      "properties": {
        "external_id": { "type": "string" },
        "tipo": { "enum": ["desconto", "couvert", "acrescimo"] },
        "valor_centavos": { "type": "integer", "minimum": 0 },
        "rateio": { "enum": ["proporcional", "igual"], "default": "proporcional" },
        "descricao": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
